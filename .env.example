OPENROUTER_API_KEY=api here 
OPENROUTER_APP_NAME=AI Video Summarizer
OPENROUTER_APP_URL=http://localhost:8501

# Change model slugs here only.
VIDEO_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

REASONING_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,inclusionai/ling-3.1-flash

