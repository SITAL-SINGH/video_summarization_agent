MODEL_TEMPERATURE=0.1
MODEL_MAX_RETRIES=2

VIDEO_CHUNK_SECONDS=480
FRAMES_PER_CHUNK=4
AUDIO_BITRATE_KBPS=32

MAX_VIDEO_MINUTES=90
MAX_UPLOAD_MB=500

SEARCH_MAX_CLAIMS=5
SEARCH_RESULTS_PER_CLAIM=3

DATABASE_PATH=data/summaries.db

STREAMLIT_BACKEND_URL=http://localhost:8000